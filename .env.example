# Connexion MySQL/MariaDB Alwaysdata. Encoder les caractères spéciaux du mot de passe.
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@SERVEUR.mysql.db:3306/NOM_BASE"

# Auth.js : générer une valeur avec `npx auth secret`.
AUTH_SECRET="REMPLACER_PAR_UN_SECRET_LONG_ET_ALEATOIRE"
AUTH_URL="http://localhost:3000"

# Stockage privé des documents de candidature.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REMPLACER"

# Requis uniquement lors de `npm run seed`.
ADMIN_INITIAL_NOM="Administrateur principal"
ADMIN_INITIAL_EMAIL="administrateur@example.cd"
ADMIN_INITIAL_MOT_DE_PASSE="REMPLACER_PAR_UN_MOT_DE_PASSE_FORT"

# Requis uniquement pour `npm run seed:demonstration`.
# Utiliser exclusivement un mot de passe réservé aux comptes étudiants fictifs.
MOT_DE_PASSE_ETUDIANTS_DEMO="MOT_DE_PASSE_ETUDIANTS_DEMO="besu@cd2026-2027"
